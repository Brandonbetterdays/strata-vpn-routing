{
  "input": [
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "ru",
        "uri": "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/text/ru.txt"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "direct",
        "uri": "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/text/ru.txt"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "direct",
        "uri": "./direct-custom.txt"
      }
    },
    {
      "type": "text",
      "action": "remove",
      "args": {
        "name": "direct",
        "uri": "./direct-exclude.txt"
      }
    },
    {
      "type": "private",
      "action": "add"
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputName": "geoip.dat",
        "wantedList": ["direct", "ru", "private"]
      }
    }
  ]
}
